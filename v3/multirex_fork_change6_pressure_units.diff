@@ -59,6 +59,36 @@ from astropy.constants import M_jup, M_earth, R_jup, R_earth, R_sun, M_sun
 #########################################
 # Predefine the opacity path with the data included in the package
 taurex.log.disableLogging()
+# ---------------------------------------------------------------------------------------------
+# Fork change 6 (2026-09-12, made conditional 2026-10-16): pressure units of the Exo-Transmit
+# opacity tables. TauREx <= 3.3.2 multiplies the pressure line of each opac*.dat table by 1e5,
+# i.e. reads it as bar. Exo-Transmit's tables are in Pa: its own reader computes number density
+# as n = P / (k_B T) with k_B in J/K (Exo_Transmit readopactable.c; "all quantities in SI units",
+# USR_MANUAL). Unpatched, every cross section is looked up at a pressure 1e5 times too low.
+# Reported as ucl-exoplanets/taurex3 issue 172; fixed upstream in pull request 174 (2026-09-14),
+# not yet in a release. The correction is therefore applied only when the loaded grid still
+# carries the 1e5 factor relative to the file, so the same code is right before and after the
+# TauREx fix.
+import taurex.opacity.exotransmit as _et
+if not getattr(_et.ExoTransmitOpacity, "_multirex_pa_fix", False):
+    _et_orig_load = _et.ExoTransmitOpacity._load_exo_transmit
+
+    def _et_load_pa(self, filename):
+        _et_orig_load(self, filename)
+        with open(filename) as _fh:
+            _fh.readline()
+            _file_grid = np.array([float(c) for c in _fh.readline().split()])
+        _ratio = float(self._pressure_grid.min()) / float(_file_grid.min())
+        if abs(_ratio - 1e5) < 1e-3 * 1e5:            # TauREx read the grid as bar: undo it
+            self._pressure_grid = self._pressure_grid / 1e5
+            self._min_pressure = self._pressure_grid.min()
+            self._max_pressure = self._pressure_grid.max()
+        elif abs(_ratio - 1.0) > 1e-6:
+            raise RuntimeError(f"Exo-Transmit pressure grid of {filename} is {_ratio:g} x the file's; expected 1 or 1e5")
+
+    _et.ExoTransmitOpacity._load_exo_transmit = _et_load_pa
+    _et.ExoTransmitOpacity._multirex_pa_fix = True
+# ---------------------------------------------------------------------------------------------
 OpacityCache().clear_cache()
 xsec_path = os.path.join(os.path.dirname(__file__), 'data')
 OpacityCache().set_opacity_path(xsec_path)
