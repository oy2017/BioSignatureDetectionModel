            </opticalElement>
        </optics>
        <detector>
            <delta_pix unit="micron">18.0</delta_pix>
            <read_noise unit="count">15</read_noise>
            <dark_current unit="count/s">1</dark_current>
            <well_depth unit="count">100000</well_depth>
            <f_well_depth unit="">1.0</f_well_depth>
            <qe unit="">0.7</qe>
            <wl_min unit="micron">0.7</wl_min>
            <cut_off unit="micron">1.2</cut_off>
            <freqNDR unit="Hz">0.</freqNDR>
        </detector>
    </channel>

    <!-- ===================== NIRSpec 1.10-1.95 um, R=15 ===================== -->
    <channel>NIRSpec
        <channelClass>Spectrometer</channelClass>
        <wl_min unit="micron">1.10</wl_min>
        <wl_max unit="micron">1.95</wl_max>
        <Fnum_x unit="">15</Fnum_x>
        <Fnum_y unit="">20</Fnum_y>
        <NoiseX unit="">0.0</NoiseX>
        <targetR unit="">15.0</targetR>
        <wlSolution>
            <datafile>__ConfigPath__/nirspec_wlsol.csv</datafile>
        </wlSolution>
        <optics>
            <opticalElement>filt
                <type>filter</type>
                <wl_min unit="micron">1.10</wl_min>
                <wl_max unit="micron">1.95</wl_max>
                <transmission>0.6</transmission>
