         <sn:authorInfo>
            <rdf:Bag>
               <rdf:li rdf:parseType="Resource">
                  <author:name>Giovanna Tinetti</author:name>
                  <author:orcid>http://orcid.org/0000-0001-6058-6654</author:orcid>
